__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.pytest_cache/
/node_modules/
.DS_Store
pdv-python/build/
pdv-python/.venv/
# The sweep and local dev create ad-hoc venvs/locks under pdv-python; the
# package ships without a committed lockfile (libraries pin floors, not locks).
pdv-python/uv.lock
.playwright-mcp/

# Claude Code local working files (plans, settings, agent worktrees)
.claude/

# Electron
electron/node_modules/
electron/dist/
electron/release/
electron/out/
electron/.cache/
electron/renderer/dist/
electron/logs
electron/.mcp.json
electron/playwright-report/
electron/test-results/
electron/e2e/.fixtures-cache/
# Build artifacts produced by scripts/ (uv binary, pdv-python wheel).
electron/resources/

# Defensive: prevent accidentally committing a stray root-level
# package-lock.json created by running `npm install` in the repo root
# (there is no root package.json — the npm project lives under electron/).
# electron/package-lock.json IS tracked and required.
/package-lock.json

# Playwright results and the audit scratch dir when run from the repo root.
/test-results/
/.pdv_audit/

pdv-icon.iconset

# Docs
site/
# Julia package manager artifacts (pdv-julia is a library; the manifest is machine-local)
pdv-julia/Manifest.toml
