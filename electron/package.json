{
  "name": "physics-data-viewer",
  "version": "0.1.2",
  "uvVersion": "0.11.6",
  "private": true,
  "author": {
    "name": "Matthew Pharr",
    "email": "m.pharr@protonmail.com",
    "url": "https://github.com/matt-pharr"
  },
  "homepage": "https://github.com/matt-pharr/physics-data-viewer",
  "main": "dist/main/bootstrap.js",
  "electronmon": {
    "patterns": [
      "!dist/**"
    ]
  },
  "repository": {
    "url": "https://github.com/matt-pharr/physics-data-viewer"
  },
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "node ./node_modules/cross-env/dist/bin/cross-env.js NODE_ENV=development node ./node_modules/electronmon/bin/cli.js .",
    "dev:renderer": "cd renderer && node ../node_modules/vite/bin/vite.js",
    "generate:icon:mac": "sh ./scripts/generate-mac-icon.sh && sh ./scripts/build-icon.sh",
    "fetch:uv": "node scripts/fetch-uv.mjs --host",
    "build:pdv-wheel": "node scripts/build-pdv-wheel.mjs",
    "prebuild": "node scripts/fetch-uv.mjs && node scripts/build-pdv-wheel.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd renderer && node ../node_modules/vite/bin/vite.js build",
    "build:main": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:e2e": "npm run build",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test --config=playwright.config.ts",
    "test:e2e:headed": "node ./node_modules/@playwright/test/cli.js test --headed --config=playwright.config.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "typecheck:renderer": "node ./node_modules/typescript/bin/tsc -p renderer/tsconfig.json --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "clean": "rm -rf dist renderer/dist release node_modules renderer/node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@monaco-editor/react": "^4.6.0",
    "ansi-to-html": "^0.7.2",
    "electron-updater": "^6.6.2",
    "katex": "^0.16.47",
    "marked": "^18.0.4",
    "marked-katex-extension": "^5.1.8",
    "monaco-editor": "^0.55.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.7",
    "smol-toml": "^1.6.1",
    "zeromq": "^6.5.0",
    "zod": "^4.4.3"
  }
}
